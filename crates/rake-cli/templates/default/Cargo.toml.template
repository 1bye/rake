[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.98"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]

[features]
devtools = ["rake/devtools"]
live = ["rake/live"]
# Resolve both GPUI backends to compatible versions even when only one is built.
gpui-fast = ["rake/gpui-fast"]

[dependencies]
rake = {{dependency}}

[package.metadata.rake.bundle]
name = "{{name}}"
identifier = "{{application_id}}"
